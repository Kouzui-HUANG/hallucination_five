---
/**
 * 創辦人頁（設計文件 §3-5，結構參考 heart2thriving 的「關於宏瑞」）：/team/<slug>/ 與 /ja/team/<slug>/ 共用
 * Hero → 數字 → About → 代表作 → 獲獎 → 經歷 → 其他連結 → CTA
 * schema：ProfilePage ＋ Person（@id 供 Organization.founder 與 VideoObject.director 參照）
 * 日文頁：要翻譯的欄位與本文來自 team/<slug>/ja.md；姓名、肖像、連結、作品與獲獎沿用 index.md
 */
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import DevCard from '../components/DevCard.astro';
import AwardsList from '../components/AwardsList.astro';
import CtaBand from '../components/CtaBand.astro';
import { getSiteData, worksByMember, awardsOf } from '../data/queries';
import { absRoutes as absIds, absAsset } from '../data/site';
import { LANG_META, absRoutesFor, awardText, langOf, quoteTitle, routesFor, t } from '../i18n';

interface Props {
  slug: string;
}

const lang = langOf(Astro.url);
const dict = t(lang);
const copy = dict.team;
const routes = routesFor(lang);
const absRoutes = absRoutesFor(lang);

const { works, awards, teamById, teamJaById } = await getSiteData();
const member = teamById.get(Astro.props.slug)!;
const memberJa = lang === 'ja' ? teamJaById.get(member.id) : undefined;
if (lang === 'ja' && !memberJa) throw new Error(`缺少 src/content/team/${member.id}/ja.md`);
/* d：姓名、肖像、連結等不翻譯的欄位；local：要翻譯的欄位（日文頁換成 ja.md） */
const d = member.data;
const local = memberJa ? { ...d, ...memberJa.data } : d;
const { Content } = await render(memberJa ?? member);

const memberWorks = worksByMember(works, member.id);
const memberAwards = awardsOf(awards, member.id);
const pageUrl = absRoutes.team(member.id);

const SAME_AS_LABEL: Record<string, string> = copy.sameAs;
const siteLabel = (url: string) => {
  const host = new URL(url).hostname.replace(/^www\./, '');
  if (host === 'vocus.cc') return copy.vocus;
  if (host === 'portaly.cc') return 'Portaly';
  return host;
};
const links = Object.entries(d.sameAs)
  .filter(([, url]) => !!url)
  .map(([key, url]) => ({ label: SAME_AS_LABEL[key] ?? siteLabel(url as string), url: url as string }));

const portraitImg = await getImage({ src: d.portrait, width: 800, format: 'jpg', quality: 85 });

const tx = awardText(lang);
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: pageUrl,
  dateModified: `${local.updatedAt}T00:00:00+08:00`,
  ...(lang === 'ja' ? { inLanguage: LANG_META.ja.hreflang } : {}),
  mainEntity: {
    '@type': 'Person',
    '@id': absIds.personId(member.id),
    name: d.name,
    alternateName: [d.nameEn, ...d.alias],
    jobTitle: local.jobTitle,
    description: local.description,
    image: absAsset(portraitImg.src),
    url: absIds.team(member.id),
    worksFor: { '@id': absIds.organizationId() },
    ...(d.alumniOf.length
      ? { alumniOf: d.alumniOf.map((name) => ({ '@type': 'EducationalOrganization', name })) }
      : {}),
    ...(d.knowsLanguage.length ? { knowsLanguage: d.knowsLanguage } : {}),
    knowsAbout: local.specialties,
    ...(memberAwards.length
      ? {
          award: memberAwards.map(
            (a) => `${a.year} ${tx.title(a.title)} ${tx.result(a.result)}${a.workTitle ? quoteTitle(lang, a.workTitle) : ''}`,
          ),
        }
      : {}),
    sameAs: links.map((l) => l.url),
  },
};
---

<BaseLayout
  title={d.name}
  seoTitle={local.seoTitle}
  description={local.description}
  ogImage={portraitImg.src}
  ogType="profile"
  schemas={[personSchema]}
  breadcrumbs={[
    { name: dict.crumbs.about, item: absRoutes.about() },
    { name: d.name, item: pageUrl },
  ]}
>
  <header class="profile">
    <div class="container profile__grid">
      <div>
        <nav class="crumbs" aria-label={dict.crumbs.aria}>
          <a href={routes.home()}>{dict.crumbs.home}</a><span aria-hidden="true">／</span>
          <a href={routes.about()}>{dict.crumbs.about}</a><span aria-hidden="true">／</span>
          <span aria-current="page">{d.name}</span>
        </nav>
        <h1 class="profile__name">{d.name}</h1>
        <p class="profile__role label">{local.role}</p>
        <p class="profile__en label">
          <span lang="en">{d.nameEn}</span>
          {d.alias.map((a) => <span>{a}</span>)}
        </p>
        <p class="profile__tagline">{local.tagline}</p>
        <ul class="tags">{local.specialties.map((s) => <li>{s}</li>)}</ul>
      </div>
      <figure class="profile__ph">
        <Image src={d.portrait} alt={local.portraitAlt} widths={[320, 480, 640]} sizes="(max-width: 900px) 60vw, 360px" loading="eager" />
      </figure>
    </div>
  </header>

  {
    local.numbers.length > 0 && (
      <section class="numbers" aria-label={copy.numbersAria(d.name)}>
        <div class="container">
          <ul class="numbers__grid">
            {local.numbers.map((n) => (
              <li class="numbers__item">
                <b class="num__value f-subset">
                  {n.value}
                  {n.unit && <small>{n.unit}</small>}
                </b>
                <span class="num__label">{n.label}</span>
                {n.note && (
                  <span class="num__note">
                    {n.note.split('・').map((part) => (
                      <span>{part}</span>
                    ))}
                  </span>
                )}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section" aria-labelledby="about-title">
    <div class="container about-grid">
      <SectionHead title={copy.aboutTitle(d.name)} id="about-title" />
      <div class="prose">
        <Content />
      </div>
    </div>
  </section>

  {
    memberWorks.length > 0 && (
      <section class="section section--tight" aria-labelledby="works-title">
        <div class="container">
          <SectionHead title={copy.worksTitle} id="works-title" link={{ href: routes.works(), label: copy.worksAll }} />
          <div class="dev-grid">
            {memberWorks.map((w) => (
              <DevCard work={w} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    memberAwards.length > 0 && (
      <section class="section section--tight" aria-labelledby="awards-title">
        <div class="container">
          <SectionHead title={copy.awardsTitle} id="awards-title" />
          <AwardsList rows={memberAwards} />
        </div>
      </section>
    )
  }

  {
    local.timeline.length > 0 && (
      <section class="section section--tight" aria-labelledby="timeline-title">
        <div class="container">
          <SectionHead title={copy.timelineTitle} id="timeline-title" />
          <ol class="timeline">
            {local.timeline.map((t) => (
              <li class="timeline__item">
                <span class="timeline__year num">{t.year}</span>
                <div>
                  <p class="timeline__title">{t.title}</p>
                  {t.note && <p class="timeline__note">{t.note}</p>}
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  {
    links.length > 0 && (
      <section class="section section--tight" aria-labelledby="links-title">
        <div class="container">
          <SectionHead title={copy.linksTitle} id="links-title" />
          <ul class="links">
            {links.map((l) => (
              <li>
                <a class="links__item" href={l.url} target="_blank" rel="noopener noreferrer">
                  {l.label} <Icon name="external" size={14} />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <CtaBand title={copy.ctaTitle(d.name)} />
</BaseLayout>

<style>
  .profile {
    padding: clamp(48px, 7vw, var(--space-3xl)) 0 clamp(var(--space-xl), 5vw, var(--space-2xl));
    border-bottom: 1px solid var(--line);
  }
  .profile__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 360px);
    gap: 56px;
    align-items: end;
  }
  .profile__name {
    font-size: clamp(48px, 8vw, 112px);
    line-height: 1.05;
    letter-spacing: 0.08em;
  }
  /* 職稱與羅馬拼音接在名字下方（.label），跟 PersonCard 同一個順序 */
  .profile__role {
    margin-top: var(--space-xs);
  }
  /* 羅馬拼音與別名各自一格，不用間隔號串起來 */
  .profile__en {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-sm);
    margin-top: var(--space-md);
  }
  .profile__tagline {
    max-width: 30em;
    margin: var(--space-lg) 0 var(--space-lg);
    font-size: clamp(17px, 1.6vw, 20px);
    color: var(--text-soft);
  }
  .profile__ph {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--bg-raised);
  }
  /* 肖像跟 PersonCard 同一種處理：黑白相紙 */
  .profile__ph img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
  }
  .numbers {
    background: var(--bg-sunken);
    border-bottom: 1px solid var(--line);
  }
  .numbers__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  /* 格子的類名不用 .num：那是全站的數字字體 class（global.css） */
  .numbers__item {
    padding: 44px 28px;
    border-left: 1px solid var(--line);
  }
  .numbers__item:first-child {
    padding-left: 0;
    border-left: 0;
  }
  .num__value {
    display: block;
    font-family: var(--font-figure);
    font-stretch: 125%;
    font-size: clamp(36px, 4.4vw, 60px);
    font-weight: var(--display-weight);
    line-height: 1.05;
    font-variant-numeric: tabular-nums;
  }
  .num__value small {
    margin-left: var(--space-xs);
    font-family: var(--font-body);
    font-size: 0.34em;
    font-weight: 600;
    color: var(--muted);
  }
  .num__label {
    display: block;
    margin-top: var(--space-md);
    font-weight: 600;
  }
  /* 註記裡的多個項目各自一格，不用間隔號串起來 */
  .num__note {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-sm);
    margin-top: var(--space-3xs);
    font-size: 13px;
    color: var(--muted);
  }
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: 48px;
    align-items: start;
  }
  .about-grid :global(.sec-head) {
    margin-bottom: 0;
  }
  .timeline {
    border-top: 1px solid var(--line);
  }
  .timeline__item {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: var(--space-lg);
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }
  .timeline__year {
    font-size: 15px;
    color: var(--muted);
  }
  .timeline__title {
    font-weight: 600;
  }
  .timeline__note {
    margin-top: var(--space-3xs);
    font-size: 14px;
    color: var(--muted);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  .links__item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    height: 44px;
    padding: 0 20px;
    font-weight: 600;
    border: 1px solid var(--line);
    transition:
      border-color var(--dur-short),
      color var(--dur-short);
  }
  .links__item:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  @media (max-width: 900px) {
    .profile__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
    .profile__ph {
      max-width: 280px;
      order: -1;
    }
    .about-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
  @media (max-width: 640px) {
    .numbers__grid {
      grid-template-columns: 1fr;
    }
    .numbers__item,
    .numbers__item:first-child {
      padding: 28px 0;
      border-left: 0;
    }
    .numbers__item + .numbers__item {
      border-top: 1px solid var(--line);
    }
    .timeline__item {
      grid-template-columns: 56px minmax(0, 1fr);
      gap: var(--space-sm);
    }
  }
</style>

---
/** 獲獎紀錄：年份｜賽事｜名次｜作品（有作品頁的連過去）；有實體照片的獎項接在列表後 */
import AwardPhoto from './AwardPhoto.astro';
import { routes } from '../data/site';
import type { AwardRow } from '../data/queries';

interface Props {
  rows: AwardRow[];
}

const { rows } = Astro.props;
const withPhoto = rows.filter((a) => a.photos?.length);
---

<ul class="awards">
  {
    rows.map((a) => (
      <li class="aw">
        <span class="aw__year num">{a.year}</span>
        <span class="aw__event">{a.title}</span>
        <span class:list={['aw__result', a.winner && 'is-winner']}>{a.result}</span>
        <span class="aw__work">
          {a.workSlug ? (
            <a href={routes.work(a.workSlug)}>《{a.workTitle}》</a>
          ) : a.workTitle ? (
            `《${a.workTitle}》`
          ) : (
            ''
          )}
        </span>
      </li>
    ))
  }
</ul>

{
  withPhoto.length > 0 && (
    <div class="aw-photos">
      {withPhoto.map((a) => (
        <AwardPhoto
          photos={a.photos!}
          label={a.photoLabel ?? '獎狀'}
          year={a.year}
          title={a.title}
          result={a.result}
          workTitle={a.workTitle}
          workHref={a.workSlug && routes.work(a.workSlug)}
        />
      ))}
    </div>
  )
}

<style>
  .awards {
    border-top: 1px solid var(--line);
  }
  .aw-photos {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    margin-top: 32px;
  }
  .aw {
    display: grid;
    grid-template-columns: 72px minmax(0, 2fr) 110px minmax(0, 1.3fr);
    align-items: baseline;
    gap: var(--space-lg);
    padding: var(--space-lg) 0;
    border-bottom: 1px solid var(--line);
  }
  .aw__year {
    font-size: 14px;
    color: var(--muted);
  }
  .aw__event {
    font-weight: 600;
  }
  .aw__result {
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--text-soft);
  }
  .aw__result.is-winner {
    color: var(--text);
  }
  /* 長片名（含日文）在窄欄裡兩行排平，不讓「歌～》」單獨落在最後一行 */
  .aw__work {
    color: var(--muted);
    text-wrap: balance;
  }
  .aw__work a {
    transition: color 0.2s;
  }
  .aw__work a:hover {
    color: var(--text);
  }
  @media (max-width: 640px) {
    .aw {
      grid-template-columns: 52px minmax(0, 1fr);
      row-gap: var(--space-3xs);
    }
    .aw__result,
    .aw__work {
      grid-column: 2;
    }
  }
</style>

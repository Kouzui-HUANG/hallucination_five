---
/** 獎項的實體照片（獎盃、獎狀）：作品頁與獲獎列表共用；有 workTitle 才顯示作品名 */
import { Image } from 'astro:assets';

interface Props {
  photos: { src: ImageMetadata; alt: string }[];
  label: string;
  year: number;
  title: string;
  result: string;
  workTitle?: string;
  workHref?: string;
}

const { photos, label, year, title, result, workTitle, workHref } = Astro.props;
---

<figure class:list={['aw-photo', photos.length > 1 && 'aw-photo--multi']}>
  {
    photos.map((p) => (
      <Image class="aw-photo__img" src={p.src} alt={p.alt} widths={[420, 840]} sizes="(max-width: 480px) 100vw, 420px" loading="lazy" decoding="async" />
    ))
  }
  <figcaption class="aw-photo__cap">
    <span class="aw-photo__label label">{label}</span>
    <span class="aw-photo__title">{year} {title} {result}</span>
    {workTitle && (workHref ? <a href={workHref}>《{workTitle}》</a> : <span>《{workTitle}》</span>)}
  </figcaption>
</figure>

<style>
  .aw-photo {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-md) var(--space-lg);
  }
  .aw-photo__img {
    flex: 1 1 220px;
    min-width: 0;
    max-width: 420px;
    height: auto;
    border: 1px solid var(--line);
  }
  .aw-photo__cap {
    flex: 1 1 200px;
    display: grid;
    gap: var(--space-2xs);
    color: var(--muted);
  }
  .aw-photo--multi .aw-photo__cap {
    flex-basis: 100%;
  }
  .aw-photo__title {
    font-weight: 600;
    color: var(--text);
  }
  .aw-photo__cap a {
    transition: color 0.2s;
  }
  .aw-photo__cap a:hover {
    color: var(--text);
  }
</style>

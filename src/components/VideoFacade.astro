---
/**
 * 影片 lite facade（沿用圖鑑）：預設只渲染縮圖＋播放鈕，點擊才注入 <iframe>，首屏不載入 YouTube 的 JS。
 * YouTube 用 youtube-nocookie.com 嵌入。沒有影片（客戶案只給劇照）時只顯示縮圖。
 */
import { Image } from 'astro:assets';
import { parseVideoUrl, type Work } from '../data/queries';

interface Props {
  work: Work;
}

const { work } = Astro.props;
const { title, thumb, thumbAlt, videoUrl } = work.data;
const video = videoUrl ? parseVideoUrl(videoUrl) : null;
const canEmbed = !!video && video.provider !== 'unknown' && !!video.embedUrl;
const watchLabel = video?.provider === 'youtube' ? '在 YouTube 觀看 ↗' : video?.provider === 'vimeo' ? '在 Vimeo 觀看 ↗' : '在原站觀看 ↗';
---

<div class="video">
  <div class="facade" data-embed={canEmbed ? video?.embedUrl : undefined} data-title={title}>
    <Image
      src={thumb}
      alt={thumbAlt}
      widths={[640, 960, 1280]}
      sizes="(max-width: 1280px) 100vw, 1184px"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    {
      canEmbed && (
        <button type="button" class="facade__play" aria-label={`播放《${title}》`}>
          <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false">
            <path d="M7 4.5v15l12-7.5z" fill="currentColor" />
          </svg>
        </button>
      )
    }
  </div>
  {
    video && (
      <p class="video__credit">
        <a href={video.watchUrl} target="_blank" rel="noopener noreferrer">{watchLabel}</a>
      </p>
    )
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('.facade[data-embed]').forEach((root) => {
    const btn = root.querySelector<HTMLButtonElement>('.facade__play');
    const embed = root.dataset.embed;
    if (!btn || !embed) return;
    btn.addEventListener(
      'click',
      () => {
        const iframe = document.createElement('iframe');
        iframe.src = embed;
        iframe.title = root.dataset.title ?? '';
        iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;
        iframe.className = 'facade__iframe';
        iframe.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
        root.replaceChildren(iframe);
        // 被點擊的按鈕已移除，把焦點交給播放器（WCAG 2.4.3）
        iframe.tabIndex = -1;
        iframe.focus();
      },
      { once: true },
    );
  });
</script>

<style>
  .facade {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-raised);
  }
  .facade img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .facade__play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 84px;
    height: 84px;
    margin: -42px 0 0 -42px;
    padding-left: 4px;
    color: var(--text);
    cursor: pointer;
    border-radius: 50%;
    border: 1px solid rgb(241 237 230 / 0.7);
    background: rgb(14 14 16 / 0.45);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .facade__play:hover,
  .facade__play:focus-visible {
    color: var(--accent-ink);
    background: var(--accent);
    border-color: var(--accent);
  }
  .facade :global(.facade__iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .video__credit {
    margin-top: 10px;
    font-size: 13px;
    color: var(--muted);
  }
  .video__credit a:hover {
    color: var(--text);
  }
  @media (max-width: 640px) {
    .facade__play {
      width: 60px;
      height: 60px;
      margin: -30px 0 0 -30px;
    }
  }
</style>

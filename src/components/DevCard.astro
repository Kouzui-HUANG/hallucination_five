---
/**
 * 顯影卡：黑白，hover／鍵盤聚焦時顯影成全彩（設計文件 §6-4）
 * 日文頁：作品頁只有繁中，卡片連到繁中頁並標「中国語ページ」（設計文件 §2-1）
 */
import { Image } from 'astro:assets';
import { workMetaParts, type Work } from '../data/queries';
import { awardText, categoryLabelFor, langOf, routesFor, t } from '../i18n';

interface Props {
  work: Work;
}

const { work } = Astro.props;
const lang = langOf(Astro.url);
const copy = t(lang).cards;
const routes = routesFor(lang);
const { title, slug, thumb, thumbAlt, thumbAltJa, awards } = work.data;
const alt = lang === 'ja' ? (thumbAltJa ?? '') : thumbAlt;
/* 年份與時間碼用 Archivo 等寬數字，其餘用內文字體 */
const metaParts = workMetaParts(work, categoryLabelFor(lang), copy.episodes).map((text) => ({ text, num: /^[\d:]+$/.test(text) }));
const award = awards[0];
---

<a class="dev" href={routes.work(slug)} data-category={work.data.category} hreflang={copy.zhPage ? 'zh-Hant-TW' : undefined}>
  <div class="dev__thumb">
    <Image src={thumb} alt={alt} widths={[400, 640]} sizes="(max-width: 640px) 50vw, 300px" loading="lazy" decoding="async" />
  </div>
  <p class="dev__title">{title}</p>
  <p class="meta">
    {metaParts.map((p) => <span class:list={[p.num && 'num']}>{p.text}</span>)}
    {award && <span class="badge">{awardText(lang).result(award.result)}</span>}
    {copy.zhPage && <span>{copy.zhPage}</span>}
  </p>
</a>

---
/**
 * 製作流程：六格底片條（首頁、服務總覽、方法頁共用）
 * 有 href 的步驟會出現「看實際範例 →」；current 是目前所在方法頁的步驟編號，該格加亮、不放連結
 */
import { PROCESS } from '../data/services.mjs';
import { href } from '../data/site';

interface Props {
  current?: string;
}

const { current } = Astro.props;
---

<div class="strip-wrap" tabindex="0" role="region" aria-label="製作流程六個步驟（可左右捲動）">
  <ol class="strip">
    {
      PROCESS.map((step) => {
        const isCurrent = step.no === current;
        return (
          <li class:list={['step', isCurrent && 'is-current']} aria-current={isCurrent ? 'step' : undefined}>
            <span class="step__no">FRAME {step.no}</span>
            <h3>{step.name}</h3>
            <span class="step__en">{step.nameEn}</span>
            <p>{step.body}</p>
            {step.key && <span class="step__key">幻五的方法</span>}
            {step.href && !isCurrent && (
              <a class="step__link" href={href(step.href)}>
                {step.linkLabel ?? '看實際範例'} <span aria-hidden="true">→</span>
                <span class="visually-hidden">：{step.name}</span>
              </a>
            )}
          </li>
        );
      })
    }
  </ol>
</div>
<p class="process-note">AI 負責生成，導演負責判斷。工具會換代，判斷力不會。</p>

<style>
  .strip-wrap {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }
  .strip {
    position: relative;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    min-width: 1100px;
    padding: 34px 0;
    background: var(--bg-sunken);
    border-block: 1px solid var(--line);
  }
  /* 上下兩排齒孔 */
  .strip::before,
  .strip::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 8px;
    background: repeating-linear-gradient(90deg, transparent 0 12px, rgb(241 237 230 / 0.13) 12px 24px);
  }
  .strip::before {
    top: 10px;
  }
  .strip::after {
    bottom: 10px;
  }
  .step {
    padding: 22px 24px 18px;
    border-left: 1px solid var(--line);
    scroll-snap-align: start;
  }
  .step:first-child {
    border-left: 0;
  }
  .step__no {
    font: 12px var(--font-mono);
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  .step h3 {
    margin-top: 12px;
    font-size: 18px;
    font-weight: 700;
  }
  .step__en {
    font-family: var(--font-latin);
    font-stretch: 125%;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.26em;
    color: var(--muted);
  }
  .step p {
    margin-top: 12px;
    font-size: 14px;
    line-height: 1.8;
    color: var(--muted);
  }
  .step__key {
    display: inline-block;
    margin-top: 14px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--accent);
    border: 1px solid var(--accent);
  }
  .step.is-current {
    background: var(--bg-raised);
    box-shadow: inset 0 2px 0 var(--text);
  }
  .step__link {
    display: block;
    width: fit-content;
    margin-top: 14px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--text);
    border-bottom: 1px solid rgb(241 237 230 / 0.35);
    transition: color 0.2s, border-color 0.2s;
  }
  .step__link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .process-note {
    margin-top: 28px;
    color: var(--text-soft);
  }
</style>

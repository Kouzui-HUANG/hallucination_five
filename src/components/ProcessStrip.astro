---
/**
 * 製作流程：六格流程條（首頁、服務總覽、方法頁共用）
 * 有 href 的步驟會出現「看實際範例」連結；current 是目前所在方法頁的步驟編號，該格加亮、不放連結
 */
import { PROCESS } from '../data/services.mjs';
import { href } from '../data/site';

interface Props {
  current?: string;
}

const { current } = Astro.props;
---

<div class="strip-wrap" tabindex="0" role="region" aria-label="製作流程六個步驟（可左右捲動）">
  <ol class="strip">
    {
      PROCESS.map((step) => {
        const isCurrent = step.no === current;
        return (
          <li class:list={['step', isCurrent && 'is-current']} aria-current={isCurrent ? 'step' : undefined}>
            <span class="step__no num">{step.no}</span>
            <h3>{step.name}</h3>
            <p>{step.body}</p>
            {step.key && <span class="step__key">幻五的方法</span>}
            {step.href && !isCurrent && (
              <a class="step__link" href={href(step.href)}>
                {step.linkLabel ?? '看實際範例'}
                <span class="visually-hidden">：{step.name}</span>
              </a>
            )}
          </li>
        );
      })
    }
  </ol>
</div>
<p class="process-note">AI 負責生成，導演負責判斷。工具會換代，判斷力不會。</p>

<style>
  .strip-wrap {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }
  .strip {
    position: relative;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    min-width: 1100px;
    padding: 36px 0;
    background: var(--bg-sunken);
    border-block: 1px solid var(--line);
  }
  .step {
    padding: var(--space-lg) var(--space-lg) 20px;
    border-left: 1px solid var(--line);
    scroll-snap-align: start;
  }
  .step:first-child {
    border-left: 0;
  }
  .step__no {
    font-size: var(--text-xs);
    color: var(--muted);
  }
  .step h3 {
    margin-top: var(--space-xs);
    font-size: 18px;
    font-weight: 600;
  }
  .step p {
    margin-top: var(--space-sm);
    font-size: 14px;
    line-height: 1.8;
    color: var(--muted);
  }
  .step__key {
    display: inline-block;
    margin-top: var(--space-md);
    padding: var(--space-3xs) var(--space-xs);
    font-size: 12px;
    font-weight: 600;
    color: var(--accent);
    border: 1px solid var(--accent);
  }
  .step.is-current {
    background: var(--bg-raised);
    box-shadow: inset 0 2px 0 var(--text);
  }
  .step__link {
    display: block;
    width: fit-content;
    margin-top: var(--space-md);
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    border-bottom: 1px solid var(--text-a35);
    transition: color 0.2s, border-color 0.2s;
  }
  .step__link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .process-note {
    margin-top: 28px;
    color: var(--text-soft);
  }
</style>

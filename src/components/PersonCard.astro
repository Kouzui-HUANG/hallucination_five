---
/** 創辦人卡（首頁、關於頁）：名字在前，職稱與羅馬拼音接在名字下方 */
import { Image } from 'astro:assets';
import { routes } from '../data/site';
import type { Member } from '../data/queries';

interface Props {
  member: Member;
}

const { member } = Astro.props;
const { name, nameEn, role, summary, specialties, portrait, portraitAlt } = member.data;
---

<article class="person">
  <figure class="person__ph">
    <Image src={portrait} alt={portraitAlt} widths={[240, 400]} sizes="200px" loading="lazy" decoding="async" />
  </figure>
  <div>
    <h3 class="person__name f-display">{name}</h3>
    <p class="person__role label">{role}</p>
    <p class="person__en label" lang="en">{nameEn}</p>
    <p class="person__summary">{summary}</p>
    <ul class="tags person__tags">{specialties.map((s) => <li>{s}</li>)}</ul>
    <a class="link-arrow" href={routes.team(member.id)}>認識{name.slice(1)}</a>
  </div>
</article>

<style>
  .person {
    display: grid;
    grid-template-columns: minmax(0, 190px) minmax(0, 1fr);
    gap: 28px;
    padding: 28px;
    background: var(--bg-raised);
    border: 1px solid var(--line);
  }
  .person__ph {
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }
  /* 兩張肖像同一種處理：黑白相紙 */
  .person__ph img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
  }
  .person__name {
    font-size: 28px;
    line-height: 1.3;
    letter-spacing: 0.08em;
  }
  .person__role {
    margin-top: var(--space-2xs);
  }
  .person__summary {
    margin-top: var(--space-md);
    font-size: 15px;
    color: var(--text-soft);
  }
  .person__tags {
    margin: var(--space-md) 0 20px;
  }
  @media (max-width: 640px) {
    .person {
      grid-template-columns: minmax(0, 1fr);
      padding: 20px;
    }
    .person__ph {
      max-width: 200px;
    }
  }
</style>

---
/**
 * 內頁頁首：麵包屑＋h1＋事實列＋導言（麵包屑要與 BaseLayout 的 BreadcrumbList 一致）
 * meta：標題下方的事實（例：作品的類別與年份），每一項一格；不要放只是重複標題的英文
 */
import { routes } from '../data/site';

interface Props {
  title: string;
  lead?: string;
  meta?: string[];
  crumbs?: { label: string; href?: string }[];
}

const { title, lead, meta = [], crumbs = [] } = Astro.props;
---

<header class="page-head">
  <div class="container">
    {
      crumbs.length > 0 && (
        <nav class="crumbs" aria-label="麵包屑">
          <a href={routes.home()}>首頁</a>
          {crumbs.map((c) => (
            <>
              <span aria-hidden="true">／</span>
              {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
            </>
          ))}
        </nav>
      )
    }
    <h1 class="page-head__title">{title}</h1>
    {
      meta.length > 0 && (
        <p class="page-head__meta label">
          {meta.map((m) => (
            <span>{m}</span>
          ))}
        </p>
      )
    }
    {lead && <p class="page-head__lead">{lead}</p>}
    <slot />
  </div>
</header>

---
/** 區塊標頭：中文標題本身開場（不加英文眉標與編號），右側可放一個文字連結 */
interface Props {
  title: string;
  id?: string;
  link?: { href: string; label: string };
}

const { title, id, link } = Astro.props;
---

<header class="sec-head">
  <h2 class="sec-head__title" id={id}>{title}</h2>
  {link && <a class="sec-head__all" href={link.href}>{link.label}</a>}
</header>

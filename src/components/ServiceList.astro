---
/** 四項服務的大字清單（首頁、服務總覽） */
import { SERVICES } from '../data/services.mjs';
import { routes } from '../data/site';
---

<ol class="svc">
  {
    SERVICES.map((s) => (
      <li>
        <a class="svc__row" href={routes.service(s.slug)}>
          <span class="svc__no">{s.no}</span>
          <h3 class="svc__name">
            {s.name}
            <span class="svc__en">{s.nameEn}</span>
          </h3>
          <p class="svc__desc">
            {s.summary}
            <span class="svc__for">適合：{s.forWho}</span>
          </p>
          <span class="svc__arrow" aria-hidden="true">→</span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .svc {
    border-top: 1px solid var(--line);
  }
  .svc__row {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) minmax(0, 1.35fr) 36px;
    align-items: center;
    gap: 24px;
    padding: 36px 8px;
    border-bottom: 1px solid var(--line);
    transition: background 0.3s, padding 0.3s;
  }
  .svc__row:hover {
    padding-left: 22px;
    background: var(--bg-raised);
  }
  .svc__no {
    font: 13px var(--font-mono);
    color: var(--muted);
  }
  .svc__name {
    font-size: clamp(22px, 2.5vw, 34px);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.04em;
  }
  .svc__en {
    display: block;
    margin-top: 8px;
    font-family: var(--font-latin);
    font-stretch: 125%;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .svc__desc {
    color: var(--text-soft);
  }
  .svc__for {
    display: block;
    margin-top: 6px;
    font-size: 13px;
    color: var(--muted);
  }
  .svc__arrow {
    font-size: 22px;
    color: var(--muted);
    transition: transform 0.3s, color 0.3s;
  }
  .svc__row:hover .svc__arrow {
    transform: translateX(6px);
    color: var(--accent);
  }
  @media (max-width: 1024px) {
    .svc__row {
      grid-template-columns: 44px minmax(0, 1fr) 28px;
      row-gap: 12px;
    }
    .svc__desc {
      grid-column: 2;
      grid-row: 2;
    }
    .svc__arrow {
      grid-column: 3;
      grid-row: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .svc__row,
    .svc__arrow {
      transition: none;
    }
  }
</style>

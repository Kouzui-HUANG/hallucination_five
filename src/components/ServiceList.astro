---
/** 四項服務的大字清單（首頁、服務總覽） */
import Icon from './Icon.astro';
import { SERVICES } from '../data/services.mjs';
import { routes } from '../data/site';
---

<ol class="svc">
  {
    SERVICES.map((s) => (
      <li>
        <a class="svc__row" href={routes.service(s.slug)}>
          <h3 class="svc__name f-display">{s.name}</h3>
          <p class="svc__desc">
            {s.summary}
            <span class="svc__for">適合：{s.forWho}</span>
          </p>
          <span class="svc__arrow" aria-hidden="true"><Icon name="arrow" size={22} /></span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .svc {
    border-top: 1px solid var(--line);
  }
  /* 文字貼齊容器邊（與區塊標題同一條線），hover 的底色往外多鋪 8px */
  .svc__row {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr) 36px;
    align-items: center;
    gap: var(--space-lg);
    padding: 36px 0;
    border-bottom: 1px solid var(--line);
  }
  .svc__row::before {
    content: '';
    position: absolute;
    inset: 0 calc(var(--space-xs) * -1);
    z-index: -1;
    background: var(--bg-raised);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .svc__row:hover::before {
    opacity: 1;
  }
  .svc__name {
    font-size: var(--text-title);
    line-height: 1.3;
    letter-spacing: 0.04em;
  }
  .svc__desc {
    color: var(--text-soft);
  }
  .svc__for {
    display: block;
    margin-top: var(--space-xs);
    font-size: 13px;
    color: var(--muted);
  }
  .svc__arrow {
    font-size: 22px;
    color: var(--muted);
    transition: transform 0.3s, color 0.3s;
  }
  .svc__row:hover .svc__arrow {
    transform: translateX(6px);
    color: var(--accent);
  }
  @media (max-width: 1024px) {
    .svc__row {
      grid-template-columns: minmax(0, 1fr) 28px;
      row-gap: var(--space-sm);
    }
    .svc__desc {
      grid-column: 1;
      grid-row: 2;
    }
    .svc__arrow {
      grid-column: 2;
      grid-row: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .svc__row,
    .svc__arrow {
      transition: none;
    }
  }
</style>

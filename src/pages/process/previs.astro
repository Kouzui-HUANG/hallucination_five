  }
  .note {
    margin-top: 20px;
    font-size: 14px;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .ab__bar {
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 14px;
    }
    .ab__timeline {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .flow {
      grid-template-columns: 1fr;
    }
    .flow__step + .flow__step::before {
      content: '↓';
      top: -11px;
      left: 32px;
    }
    .stage__legend {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .turn {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .cut {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
  @media (max-width: 640px) {
    .ab__panes {
      grid-template-columns: 1fr;
    }
    .ab__bar {
      padding: 12px;
    }
    .ab__play,
    .ab__sound {
      padding: 0 12px;
    }
    .ab__cut {
      padding: 8px 6px 4px;
    }
    .ab__cut-name {
      display: none;
    }
    .flow__step {
      padding: 24px 20px 28px;
    }
    .stage {
      margin-top: 48px;
    }
    .stage__legend {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .flow__step + .flow__step::before {
      left: 20px;
    }
  }
</style>

<script>
  /**
   * 同步對照播放器：以有聲音的成片（data-master）為主，預演跟著對齊。
   * 沒有 JS 時兩支影片各自保留原生 controls；有 JS 時換成共用的播放列。
   */
  document.querySelectorAll<HTMLElement>('[data-ab]').forEach((root) => {
    const vids = Array.from(root.querySelectorAll<HTMLVideoElement>('video'));
    const master = root.querySelector<HTMLVideoElement>('video[data-master]');
    const bar = root.querySelector<HTMLElement>('.ab__bar');
    const playBtn = root.querySelector<HTMLButtonElement>('.ab__play');
    const playLabel = root.querySelector<HTMLElement>('.ab__play-label');
    const soundBtn = root.querySelector<HTMLButtonElement>('.ab__sound');
    const now = root.querySelector<HTMLElement>('.ab__now');
    const progress = root.querySelector<HTMLElement>('.ab__progress');
    const cutBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('.ab__cut'));
    if (!master || !bar || !playBtn || !playLabel || !soundBtn || !now || !progress) return;

    const followers = vids.filter((v) => v !== master);
    const starts = cutBtns.map((b) => Number(b.dataset.start) || 0);
    const fallbackDuration = Number(root.dataset.duration) || 15;

    vids.forEach((v) => v.removeAttribute('controls'));
    bar.hidden = false;
    root.classList.add('is-enhanced');

    let playing = false;
    let holding = false;
    let raf = 0;

    const fmt = (s: number) => {
      const t = Math.max(0, Math.floor(s));
      return `${String(Math.floor(t / 60)).padStart(2, '0')}:${String(t % 60).padStart(2, '0')}`;
    };

    const render = () => {
      const t = master.currentTime;
      const dur = Number.isFinite(master.duration) && master.duration > 0 ? master.duration : fallbackDuration;
      progress.style.transform = `scaleX(${Math.min(1, t / dur)})`;
      now.textContent = fmt(t);
      cutBtns.forEach((b, i) => {
        const active = t >= starts[i] && t < (starts[i + 1] ?? Infinity);
        b.classList.toggle('is-active', active);
        if (active) b.setAttribute('aria-current', 'true');
        else b.removeAttribute('aria-current');
      });
    };

    /* 我們自己呼叫 pause() 會讓還沒完成的 play() 以 AbortError 結束，那不算失敗 */
    const onPlayError = (e: unknown) => {
      if ((e as DOMException)?.name !== 'AbortError') setPlaying(false);
    };

    /* rAF 負責順暢更新；timeupdate 是背景分頁（rAF 暫停）時的備援 */
    const step = () => {
      if (playing) {
        // 任一支還在緩衝：已經能播的先停下來等，全部就緒再一起走，避免畫面錯開
        const lagging = vids.some((v) => !v.ended && v.readyState < HTMLMediaElement.HAVE_FUTURE_DATA);
        if (lagging) {
          holding = true;
          vids.forEach((v) => {
            if (v.readyState >= HTMLMediaElement.HAVE_FUTURE_DATA && !v.paused) v.pause();
          });
        } else if (holding) {
          holding = false;
          vids.forEach((v) => {
            if (v.paused && !v.ended) v.play().catch(onPlayError);
          });
        }
        if (!holding) {
          followers.forEach((v) => {
            if (!v.seeking && !v.ended && Math.abs(v.currentTime - master.currentTime) > 0.1) {
              v.currentTime = master.currentTime;
            }
          });
        }
      }
      render();
    };
    const tick = () => {
      step();
      if (playing) raf = requestAnimationFrame(tick);
    };

    function setPlaying(on: boolean) {
      playing = on;
      holding = false;
      root.classList.toggle('is-playing', on);
      playBtn!.setAttribute('aria-pressed', String(on));
      playLabel!.textContent = on ? '暫停' : '同步播放';
      cancelAnimationFrame(raf);
      if (on) {
        vids.forEach((v) => v.play().catch(onPlayError));
        raf = requestAnimationFrame(tick);
      } else {
        vids.forEach((v) => v.pause());
        render();
      }
    }

    const seek = (t: number) => {
      vids.forEach((v) => {
        v.currentTime = t;
      });
      render();
    };

    playBtn.addEventListener('click', () => setPlaying(!playing));
    vids.forEach((v) => v.addEventListener('click', () => setPlaying(!playing)));

    master.addEventListener('ended', () => {
      setPlaying(false);
      seek(0);
    });
    // 任一支緩衝完成或前進時都檢查一次，被暫停等待的那支才會被叫醒
    vids.forEach((v) => ['timeupdate', 'canplay', 'playing'].forEach((ev) => v.addEventListener(ev, step)));
    master.addEventListener('seeked', render);
    master.addEventListener('loadedmetadata', render);

    cutBtns.forEach((b, i) => {
      b.addEventListener('click', () => {
        seek(starts[i]);
        if (!playing) setPlaying(true);
      });
    });

    soundBtn.addEventListener('click', () => {
      master.muted = !master.muted;
      soundBtn.setAttribute('aria-pressed', String(!master.muted));
      soundBtn.textContent = master.muted ? '聲音：關' : '聲音：開';
    });
  });
</script>

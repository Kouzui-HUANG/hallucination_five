  }

  /* ── 怎麼做的 ─────────────────────────────── */
  .flow {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .flow__step {
    position: relative;
    padding: 28px 32px 32px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  /* 步驟之間的箭頭 */
  .flow__step + .flow__step::before {
    content: '→';
    position: absolute;
    top: 26px;
    left: -11px;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    font-size: 12px;
    color: var(--muted);
    background: var(--bg);
  }
  .flow__no {
    font: 12px var(--font-mono);
    color: var(--muted);
  }
  .flow__en {
    margin-top: 10px;
    font-size: 11px;
    font-weight: 600;
    font-stretch: 125%;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .flow__name {
    font-size: 22px;
    font-weight: 700;
  }
  .flow__tool {
    margin-top: 2px;
    font-weight: 600;
    color: var(--text);
  }
  .flow__body {
    margin-top: 12px;
    color: var(--text-soft);
  }

  /* 導演台截圖 */
  .stage {
    margin-top: 64px;
  }
  .stage__link {
    position: relative;
    display: block;
    overflow: hidden;
    background: var(--bg-raised);
    border: 1px solid var(--line);
  }
  .stage__link img {
    width: 100%;
    height: auto;
  }
  .stage__zoom {
    position: absolute;
    right: 12px;
    bottom: 12px;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--text);
    background: rgb(14 14 16 / 0.72);
    border: 1px solid rgb(241 237 230 / 0.35);
    opacity: 0;
    transition: opacity 0.2s;
  }
  .stage__link:hover .stage__zoom,
  .stage__link:focus-visible .stage__zoom {
    opacity: 1;
  }
  @media (hover: none) {
    .stage__zoom {
      opacity: 1;
    }
  }
  .stage__title {
    margin-top: 16px;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .stage__legend {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    margin-top: 14px;
  }
  .stage__item dt {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
  }
  .stage__pos {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    font-size: 12px;
    color: var(--muted);
    border: 1px solid var(--line);
  }
  .stage__item dd {
    margin: 6px 0 0;
    font-size: 13px;
    line-height: 1.75;
    color: var(--muted);
  }

  .turn {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr);
    gap: 32px;
    margin-top: 64px;
    padding: 40px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .turn__h {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--muted);
  }
  .turn__body {
    max-width: 34em;
    font-size: clamp(18px, 1.8vw, 22px);
    font-weight: 600;
    line-height: 1.8;
  }
  .turn__body p + p {
    margin-top: 1em;
  }

  /* ── 四個鏡頭 ─────────────────────────────── */
  .cuts {
    border-top: 1px solid var(--line);
  }
  .cut {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 36px;
    padding: 36px 0;
    border-bottom: 1px solid var(--line);
  }
  .cut__no {
    display: flex;
    align-items: baseline;
    gap: 14px;
    font: 600 13px var(--font-mono);
    letter-spacing: 0.08em;
  }
  .cut__tc {
    font-weight: 400;
    color: var(--muted);
  }
  .cut__label {
    margin-top: 8px;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.5;
  }
  .cut__action {
    margin-top: 12px;
    color: var(--text-soft);
  }
  .cut__hold {
    margin-top: 14px;
    font-size: 14px;
    color: var(--text-soft);
  }
  .cut__hold-tag {
    display: inline-block;
    margin-right: 10px;
    padding: 0 8px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    line-height: 22px;
    color: var(--muted);
    border: 1px solid var(--line);
  }
  .cut__pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .cut__still img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--bg-raised);
  }
  .cut__still figcaption {
    margin-top: 8px;
    font-size: 12px;
    letter-spacing: 0.1em;

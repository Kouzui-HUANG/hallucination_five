  }
  .ab__cut b {
    font: 600 11px var(--font-mono);
    letter-spacing: 0.08em;
    white-space: nowrap;
  }
  .ab__cut-name {
    max-width: 100%;
    overflow: hidden;
    font-size: 13px;

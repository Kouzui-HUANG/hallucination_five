---
/**
 * BaseLayout — 頁首、選單、頁尾，以及 Organization + WebSite + BreadcrumbList schema 引擎
 * （沿用圖鑑的引擎，換成公司資料；設計文件 §7-1、§9-1）
 *
 * 語言由網址決定（/ja/ 開頭是日文）。有對應語言版本的頁面自動輸出 hreflang（zh-Hant-TW ↔ ja-JP，x-default 指向繁中）；
 * 沒有對應版本的頁面（作品頁、製作方法頁、404），語言切換連到另一個語言的首頁，不輸出 hreflang（設計文件 §7-2）。
 */
import '../styles/global.css';
import { SITE, COMPANY, PRIMARY_NAV, href, absUrl, absRoutes, legalNameLine } from '../data/site';
import { SERVICES } from '../data/services.mjs';
import { SERVICES_JA } from '../data/services.ja.mjs';
import { getSiteData } from '../data/queries';
import { LANG_META, absRoutesFor, counterpartOf, routesFor, splitLang, t } from '../i18n';
import Icon from '../components/Icon.astro';

interface Props {
  /** <h1> 用的標題（雙標題制：title 給 h1，seoTitle 給 <title>/og） */
  title?: string;
  seoTitle?: string;
  description?: string;
  /** 站內相對路徑（/og-default.png）、Astro 圖片的 src（/_astro/...）或絕對 URL */
  ogImage?: string;
  ogType?: 'website' | 'profile' | 'video.other';
  /** 頁面自帶的 JSON-LD（Person / VideoObject / Service / FAQPage…） */
  schemas?: object[];
  /** 覆寫自動（依 URL path）生成的麵包屑：首頁之後的完整層級，需與頁面可見麵包屑一致 */
  breadcrumbs?: { name: string; item: string }[];
  noindex?: boolean;
}

const {
  title,
  seoTitle,
  description,
  ogImage = '/og-default.png',
  ogType = 'website',
  schemas = [],
  breadcrumbs,
  noindex = false,
} = Astro.props;

/* 去掉 base 之後的 path（canonical、麵包屑、nav 高亮共用） */
const basePrefix = SITE.base === '/' ? '' : SITE.base;
const pathNoBase = Astro.url.pathname.startsWith(basePrefix)
  ? Astro.url.pathname.slice(basePrefix.length)
  : Astro.url.pathname;
/* lang：這一頁的語言；pathInLang：去掉 /ja 之後的 path（麵包屑、nav 高亮用） */
const { lang, path: pathInLang } = splitLang(pathNoBase);
const dict = t(lang);
const routes = routesFor(lang);
const meta = LANG_META[lang];
const pathSegments = pathInLang.replace(/\/$/, '').split('/').filter(Boolean);

const brand = dict.meta.brand;
const metaTitle = seoTitle ?? title;
const pageTitle = metaTitle ? `${metaTitle}｜${brand}` : `${brand}｜${dict.meta.homeSuffix}`;
const pageDesc = description ?? dict.meta.description;

/* 404 頁實際輸出為 /404.html（GitHub Pages 以此檔回應所有不存在的網址） */
const canonicalUrl = /^\/404(\/|\.html)?$/.test(pathNoBase)
  ? absUrl('/404.html')
  : new URL(Astro.url.pathname, SITE.origin).toString();
/* 另一個語言版本：equivalent 時輸出 hreflang（雙向），否則只當語言切換的去處 */
const other = counterpartOf(pathNoBase);
const otherMeta = LANG_META[other.lang];
const zhUrl = lang === 'zh-Hant' ? canonicalUrl : absUrl(other.path);
const jaUrl = lang === 'ja' ? canonicalUrl : absUrl(other.path);
const switchItems = (['zh-Hant', 'ja'] as const).map((l) => ({
  lang: l,
  label: t(l).langSwitch.label,
  name: t(l).langSwitch.name,
  hreflang: LANG_META[l].hreflang,
  href: l === lang ? null : href(other.path),
}));

const ogImageUrl = /^https?:/.test(ogImage)
  ? ogImage
  : ogImage.startsWith(SITE.base) && SITE.base !== '/'
    ? `${SITE.origin}${ogImage}`
    : absUrl(ogImage);

const { team } = await getSiteData();

/* ── 全域 Organization schema（每頁輸出；Person / VideoObject 以 @id 參照） ── */
const orgSameAs = Object.values(SITE.social).filter(Boolean);
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': absRoutes.organizationId(),
  name: SITE.name,
  legalName: COMPANY.legalName,
  alternateName: COMPANY.alternateNames,
  url: `${SITE.url}/`,
  description: SITE.description,
  logo: {
    '@type': 'ImageObject',
    '@id': `${SITE.url}/#logo`,
    url: absUrl('/logo.png'),
    contentUrl: absUrl('/logo.png'),
    width: 512,
    height: 512,
    caption: SITE.name,
  },
  image: { '@id': `${SITE.url}/#logo` },
  email: SITE.email,
  founder: team.map((m) => ({
    '@type': 'Person',
    '@id': absRoutes.personId(m.id),
    name: m.data.name,
    url: absRoutes.team(m.id),
  })),
  knowsLanguage: ['zh-Hant', 'ja'],
  areaServed: [
    { '@type': 'Country', name: 'Taiwan' },
    { '@type': 'Country', name: 'Japan' },
  ],
  ...(COMPANY.taxId ? { taxID: COMPANY.taxId } : {}),
  ...(orgSameAs.length ? { sameAs: orgSameAs } : {}),
};

/* ── 全域 WebSite schema：Google 的站名支援子網域層級，搜尋結果才會顯示幻五而不是圖鑑 ── */
const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': absRoutes.websiteId(),
  url: `${SITE.url}/`,
  name: SITE.name,
  alternateName: SITE.nameEn,
  description: SITE.description,
  publisher: { '@id': absRoutes.organizationId() },
  inLanguage: [LANG_META['zh-Hant'].hreflang, LANG_META.ja.hreflang],
};

/* ── BreadcrumbList：依 URL path 自動生成（動態頁請自行傳 breadcrumbs） ── */
const breadcrumbLabels: Record<string, string> = {
  works: dict.crumbs.works,
  services: dict.crumbs.services,
  about: dict.crumbs.about,
  team: dict.crumbs.team,
  contact: dict.crumbs.contact,
  privacy: dict.crumbs.privacy,
};
const homeUrl = absRoutesFor(lang).home();
const langPrefix = meta.prefix;

type BreadcrumbItem = { '@type': 'ListItem'; position: number; name: string; item: string };
const breadcrumbItems: BreadcrumbItem[] = [{ '@type': 'ListItem', position: 1, name: dict.crumbs.home, item: homeUrl }];

if (breadcrumbs) {
  breadcrumbs.forEach((b, i) => {
    breadcrumbItems.push({ '@type': 'ListItem', position: i + 2, name: b.name, item: b.item });
  });
} else {
  let cumulativePath = '';
  pathSegments.forEach((seg, i) => {
    cumulativePath += `/${seg}`;
    breadcrumbItems.push({
      '@type': 'ListItem',
      position: i + 2,
      name: breadcrumbLabels[seg] ?? seg,
      item: `${SITE.url}${langPrefix}${cumulativePath}/`,
    });
  });
}

const breadcrumbSchema =
  breadcrumbItems.length > 1
    ? { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: breadcrumbItems }
    : null;

const allSchemas = [organizationSchema, webSiteSchema, ...(breadcrumbSchema ? [breadcrumbSchema] : []), ...schemas];

const FONTS_CSS = 'https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,300..900&display=swap';

/* 標題字型：繁中頁 Noto Serif TC、日文頁 Noto Serif JP（字形依日本規範）。build 時由 astro.config.mjs 的
   display-font-subset 把佔位字串換成同語言頁面 h1、h2、.f-display 用到的字（text= 子集，只下載幾十 KB）；
   dev 時直接載整套（依 unicode-range 分片） */
const DISPLAY_FONT = {
  'zh-Hant': { base: 'https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@900&display=swap', placeholder: '__H5_DISPLAY_TEXT__' },
  ja: { base: 'https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@900&display=swap', placeholder: '__H5_DISPLAY_TEXT_JA__' },
}[lang];
const DISPLAY_FONT_CSS = import.meta.env.DEV ? DISPLAY_FONT.base : `${DISPLAY_FONT.base}&text=${DISPLAY_FONT.placeholder}`;

/* 頁尾：服務欄與公司欄 */
const footerServices = (lang === 'ja' ? SERVICES_JA : SERVICES).map((s) => ({ label: s.name, href: routes.service(s.slug) }));

// 版權年：build 時取當下台北年份
const currentYear = new Date(Date.now() + 8 * 3600 * 1000).getUTCFullYear();

/* 目前所在的主分區（nav 高亮；/team/ 歸在「關於」） */
/* /team/ 歸在「關於」、/process/（製作流程方法頁）歸在「服務」 */
const sectionAlias: Record<string, string> = { team: 'about', process: 'services' };
const navLabel = (navHref: string) => dict.layout.nav[navHref.replace(/\//g, '') as keyof typeof dict.layout.nav];
const firstSegment = pathSegments[0] ?? '';
const currentSection = sectionAlias[firstSegment] ?? firstSegment;
const navIsActive = (navHref: string) => currentSection === navHref.replace(/\//g, '');

/* 選單的洽詢鈕：首頁的 hero 已有紅色主按鈕、聯絡頁就是洽詢本身，這兩頁用外框；其他內頁用紅色實心 */
const navCtaTone = currentSection === '' || currentSection === 'contact' ? 'btn--ghost' : 'btn--accent';
---

<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDesc} />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <meta name="theme-color" content={SITE.themeColor} />
    <link rel="canonical" href={canonicalUrl} />
    {
      other.equivalent && (
        <>
          <link rel="alternate" hreflang={LANG_META['zh-Hant'].hreflang} href={zhUrl} />
          <link rel="alternate" hreflang={LANG_META.ja.hreflang} href={jaUrl} />
          <link rel="alternate" hreflang="x-default" href={zhUrl} />
        </>
      )
    }
    <link rel="icon" href={href('/favicon.ico')} sizes="any" />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <link rel="apple-touch-icon" sizes="180x180" href={href('/apple-touch-icon.png')} />

    <!-- Open Graph -->
    <meta property="og:site_name" content={brand} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={dict.meta.ogImageAlt(pageTitle)} />
    <meta property="og:locale" content={meta.ogLocale} />
    {other.equivalent && <meta property="og:locale:alternate" content={otherMeta.ogLocale} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Non-blocking font loading：拉丁字 Archivo＋標題用 Noto Serif TC 子集；內文仍是系統字（設計文件 §6-3） -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={FONTS_CSS} media="print" onload="this.media='all'" />
    <link rel="stylesheet" href={DISPLAY_FONT_CSS} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={FONTS_CSS} /><link rel="stylesheet" href={DISPLAY_FONT_CSS} /></noscript>

    {
      allSchemas.map((schema) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(schema).replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026')}
        />
      ))
    }

    <title>{pageTitle}</title>
  </head>
  <body>
    <a href="#main" class="skip">{dict.layout.skip}</a>

    <header class="hd">
      <a class="brand" href={routes.home()} aria-label={dict.layout.homeAria(brand)}>
        <span class="brand__zh">{SITE.name}</span>
        <span class="brand__en">{SITE.nameEn}</span>
      </a>
      <nav class="nav" aria-label={dict.layout.navAria}>
        {
          PRIMARY_NAV.map((item) => (
            <a
              href={href(`${langPrefix}${item.href}`)}
              class:list={['nav__link', navIsActive(item.href) && 'is-active']}
              aria-current={navIsActive(item.href) ? 'page' : undefined}
            >
              {navLabel(item.href)}
            </a>
          ))
        }
      </nav>
      <div class="hd__right">
        <nav class="lang" aria-label={dict.layout.langAria}>
          {
            switchItems.map((s, i) => (
              <>
                {i > 0 && <span aria-hidden="true">｜</span>}
                {s.href ? (
                  <a href={s.href} hreflang={s.hreflang} lang={s.lang} aria-label={s.name}>
                    {s.label}
                  </a>
                ) : (
                  <b lang={s.lang} aria-current="true">
                    <span aria-hidden="true">{s.label}</span>
                    <span class="visually-hidden">{s.name}</span>
                  </b>
                )}
              </>
            ))
          }
        </nav>
        <a class:list={['btn', navCtaTone, 'btn--sm', 'hd__cta']} href={routes.contact()}>{dict.layout.cta}</a>
        <details class="menu">
          <summary aria-label={dict.layout.menuOpen}>{dict.layout.menu}</summary>
          <nav class="menu__panel" aria-label={dict.layout.menuAria}>
            {PRIMARY_NAV.map((item) => <a href={href(`${langPrefix}${item.href}`)}>{navLabel(item.href)}</a>)}
            {
              switchItems
                .filter((s) => s.href)
                .map((s) => (
                  <a href={s.href!} hreflang={s.hreflang} lang={s.lang}>
                    {s.name}
                  </a>
                ))
            }
          </nav>
        </details>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="ft">
      <div class="container">
        <div class="ft__grid">
          <div class="ft__brand">
            <a class="brand" href={routes.home()}>
              <span class="brand__zh">{SITE.name}</span>
              <span class="brand__en">{SITE.nameEn}</span>
            </a>
            <p>{dict.layout.tagline}<br />{dict.layout.footerBlurb}</p>
            <p><a class="ft__mail" href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
            <p>{dict.layout.city}</p>
          </div>
          <div>
            <p class="ft__h">{dict.layout.footServices}</p>
            <ul class="ft__list">
              {footerServices.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
            </ul>
          </div>
          <div>
            <p class="ft__h">{dict.layout.footCompany}</p>
            <ul class="ft__list">
              <li><a href={routes.about()}>{dict.layout.aboutLink}</a></li>
              {team.map((m) => <li><a href={routes.team(m.id)}>{m.data.name}</a></li>)}
              <li><a href={routes.contact()}>{dict.layout.contactLink}</a></li>
              <li><a href={routes.privacy()}>{dict.layout.privacyLink}</a></li>
            </ul>
          </div>
          <div>
            <p class="ft__h">{dict.layout.footRelated}</p>
            <ul class="ft__list">
              <li>
                <a href={SITE.directory.url} hreflang={lang === 'ja' ? 'zh-Hant-TW' : undefined}>{SITE.directory.name}{dict.layout.directoryNote} <Icon name="external" size={14} /></a>
              </li>
            </ul>
          </div>
        </div>
        <div class="ft__legal">
          <span>{legalNameLine(lang)}{COMPANY.taxId && dict.layout.taxId(COMPANY.taxId)}</span>
          <span class="latin">© {currentYear} {SITE.nameEn}</span>
        </div>
      </div>
    </footer>

    <style>
      /* 跳至主要內容：平常移到畫面上緣之外（不用 left: -9999px，避免手機上撐出橫向捲動） */
      .skip {
        position: absolute;
        left: 12px;
        top: 12px;
        z-index: var(--z-skip);
        padding: var(--space-xs) var(--space-sm);
        background: var(--text);
        color: var(--bg);
        transform: translateY(-200%);
      }
      .skip:focus {
        transform: none;
      }

      /* ── 頁首 ─────────────────────────────── */
      .hd {
        position: sticky;
        top: 0;
        z-index: var(--z-sticky-nav);
        display: flex;
        align-items: center;
        gap: 32px;
        height: var(--header-h);
        padding: 0 var(--gutter);
        background: var(--bg-a72);
        backdrop-filter: blur(14px) saturate(1.2);
        -webkit-backdrop-filter: blur(14px) saturate(1.2);
        border-bottom: 1px solid var(--text-a07);
      }
      .brand {
        display: flex;
        align-items: baseline;
        gap: var(--space-sm);
        white-space: nowrap;
      }
      .brand__zh {
        font-size: 17px;
        font-weight: 600;
        letter-spacing: 0.14em;
      }
      .brand__en {
        font-family: var(--font-latin);
        font-stretch: 125%;
        font-weight: var(--display-weight);
        font-size: 11px;
        letter-spacing: 0.28em;
        color: var(--muted);
      }
      .nav {
        display: flex;
        gap: 32px;
        margin-left: auto;
        font-size: 15px;
      }
      .nav__link {
        position: relative;
        padding: var(--space-xs) 0;
        color: var(--muted);
        transition: color 0.2s;
      }
      .nav__link:hover,
      .nav__link.is-active {
        color: var(--text);
      }
      .nav__link.is-active::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        bottom: -2px;
        height: 1px;
        background: var(--text);
      }
      .hd__right {
        display: flex;
        align-items: center;
        gap: 20px;
      }
      .lang {
        display: flex;
        gap: var(--space-2xs);
        font-size: var(--text-xs);
        color: var(--muted);
      }
      .lang b {
        font-weight: 600;
        color: var(--text);
      }
      .lang a {
        transition: color var(--dur-short);
      }
      .lang a:hover {
        color: var(--text);
      }
      .menu {
        display: none;
        position: relative;
      }
      /* 不加外框，避免在手機上和「專案洽詢」長得一樣 */
      .menu summary {
        display: grid;
        place-items: center;
        height: 44px;
        padding: 0 var(--space-sm);
        font-size: 14px;
        list-style: none;
        cursor: pointer;
        text-decoration: underline;
        text-decoration-color: var(--text-a35);
        text-underline-offset: 5px;
      }
      .menu summary::-webkit-details-marker {
        display: none;
      }
      .menu__panel {
        position: absolute;
        right: 0;
        top: calc(100% + 10px);
        display: grid;
        width: 220px;
        padding: var(--space-xs);
        background: var(--bg-raised);
        border: 1px solid var(--line);
      }
      .menu__panel a {
        padding: var(--space-sm);
        border-bottom: 1px solid var(--line);
      }
      .menu__panel a:last-child {
        border-bottom: 0;
      }

      /* ── 頁尾 ─────────────────────────────── */
      .ft {
        padding: 72px 0 48px;
        font-size: 14px;
        color: var(--muted);
        background: var(--bg-sunken);
        border-top: 1px solid var(--line);
      }
      .ft__grid {
        display: grid;
        grid-template-columns: 1.5fr repeat(3, minmax(0, 1fr));
        gap: 36px;
      }
      .ft__brand .brand {
        margin-bottom: var(--space-md);
      }
      .ft__brand p {
        max-width: 24em;
      }
      .ft__brand p + p {
        margin-top: var(--space-sm);
      }
      .ft__mail {
        font-family: var(--font-latin);
      }
      .ft__h {
        margin-bottom: var(--space-md);
        font-size: var(--text-xs);
        font-weight: 600;
        color: var(--text);
      }
      .ft__list {
        display: grid;
        gap: var(--space-xs);
      }
      .ft a {
        transition: color 0.2s;
      }
      .ft a:hover {
        color: var(--text);
      }
      .ft__legal {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: var(--space-sm);
        margin-top: 56px;
        padding-top: var(--space-lg);
        font-size: 13px;
        border-top: 1px solid var(--line);
      }

      @media (max-width: 1024px) {
        .nav,
        .lang {
          display: none;
        }
        .menu {
          display: block;
        }
        .hd__right {
          margin-left: auto;
          gap: var(--space-sm);
        }
        .ft__grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }
      @media (max-width: 640px) {
        .brand__en {
          display: none;
        }
        .ft__brand .brand__en {
          display: inline;
        }
        .ft__grid {
          grid-template-columns: 1fr;
        }
      }
    </style>

    {/* 這個 layout 輸出 html 與 body，所以在這裡也寫明 overflow-x: clip（與 global.css 相同；Hallmark gate 34） */}
    <style is:global>
      html,
      body {
        overflow-x: clip;
      }
    </style>

    <script>
      /* 行動版選單：Esc 或點選單外面就收起來 */
      const menu = document.querySelector<HTMLDetailsElement>('.menu');
      if (menu) {
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && menu.open) {
            menu.open = false;
            menu.querySelector('summary')?.focus();
          }
        });
        document.addEventListener('click', (e) => {
          if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
        });
      }
    </script>
  </body>
</html>
